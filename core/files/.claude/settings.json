{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git blame*)",
      "Bash(git ls-files*)",
      "Bash(git rev-parse*)",
      "Bash(git remote -v)",
      "Bash(git worktree list*)",
      "Bash(git branch)",
      "Bash(git branch --list*)",
      "Bash(git branch --show-current)",
      "Bash(git branch -a*)",
      "Bash(git branch -r*)",
      "Bash(git branch -v*)",
      "Bash(git -C * status*)",
      "Bash(git -C * diff*)",
      "Bash(git -C * log*)",
      "Bash(git -C * show*)",
      "Bash(git -C * blame*)",
      "Bash(git -C * ls-files*)",
      "Bash(git -C * rev-parse*)",
      "Bash(git -C * remote -v)",
      "Bash(git -C * worktree list*)",
      "Bash(git -C * branch)",
      "Bash(git -C * branch --list*)",
      "Bash(git -C * branch --show-current)",
      "Bash(git -C * branch -a*)",
      "Bash(git -C * branch -r*)",
      "Bash(git -C * branch -v*)"
    ],
    "ask": [
      "Bash(git tag *)",
      "Bash(gh release*)",
      "Bash(npm publish*)",
      "Bash(pnpm publish*)",
      "Bash(yarn publish*)",
      "Bash(cargo publish*)",
      "Bash(twine upload*)",
      "Bash(docker push*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Read(**/.env.prod)",
      "Read(**/.env.development)",
      "Read(**/.env.dev)",
      "Read(**/.env.staging)",
      "Read(**/.env.test)",
      "Read(**/.envrc)",
      "Read(**/*.pem)",
      "Read(**/private/**)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git -C * push --force*)",
      "Bash(git -C * push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.sh\"",
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
